<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:clickable="false"
                android:focusable="false"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_file_generic" />

            <ImageView
                android:id="@+id/ivFolderPlayBadge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:contentDescription="תיקיית וידאו"
                android:focusable="false"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center_horizontal|top"
            android:lines="2"
            android:maxLines="2"
            android:textAlignment="center"
            android:textDirection="anyRtl"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAlignment="center"
            android:textDirection="anyRtl"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tvFileActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
